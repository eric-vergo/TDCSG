module

public import Mathlib.Analysis.SpecialFunctions.Complex.Circle
public import Mathlib.Algebra.Group.Subgroup.Lattice
import TDCSG.CriticalRadius.Five

/-! # The critical radius for two closed disks with fivefold rotations -/

@[expose] public section

open Complex Metric
open scoped Real

namespace FiveDisk

/-- The group generated by the clockwise fifth-turn of each closed disk about `-1` and `1`.
A generator fixes every point outside its disk. -/
noncomputable def group (r : ℝ) : Subgroup (Equiv.Perm ℂ) := by
  classical
  exact Subgroup.closure {g | ∃ c ∈ ({-1, 1} : Set ℂ), ∀ z : ℂ,
    g z = if z ∈ closedBall c r then c + exp (-(2 * π * I / 5)) * (z - c) else z}

/-- The fivefold threshold in radicals. -/
noncomputable abbrev radius : ℝ := √(3 + (1 + √5) / 2)

private theorem group_eq (r : ℝ) : group r = TDCSG.GG 5 5 r r := by
  rw [TDCSG.GG_eq_closure]
  unfold group
  congr 1
  ext g
  constructor
  · rintro ⟨c, hc, hg⟩
    rcases Set.mem_insert_iff.mp hc with h | h
    · subst c
      exact Set.mem_insert_iff.mpr (.inl (Equiv.ext hg))
    · have hc : c = 1 := h
      subst c
      exact Set.mem_insert_of_mem _ (Set.mem_singleton_iff.mpr (Equiv.ext hg))
  · intro h
    rcases Set.mem_insert_iff.mp h with h | h
    · subst g
      exact ⟨-1, Set.mem_insert _ _, fun _ ↦ rfl⟩
    · obtain rfl := Set.mem_singleton_iff.mp h
      exact ⟨1, Set.mem_insert_of_mem _ (Set.mem_singleton _), fun _ ↦ rfl⟩

/-- The infimum of the radii giving an infinite group is the stated threshold. -/
theorem critical_radius : sInf {r : ℝ | Infinite (group r)} = radius := by
  simp only [group_eq]
  exact TDCSG.CriticalRadius.criticalRadius_five

end FiveDisk
