module

public import Mathlib.Analysis.SpecialFunctions.Complex.Circle
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-! # The critical radius for two closed disks with fivefold rotations -/

@[expose] public section

open Complex Metric
open scoped Real

namespace FiveDisk

/-- The group generated by the clockwise fifth-turn of each closed disk about `-1` and `1`.
A generator fixes every point outside its disk. -/
noncomputable def group (r : ℝ) : Subgroup (Equiv.Perm ℂ) := by
  classical
  exact Subgroup.closure {g | ∃ c ∈ ({-1, 1} : Set ℂ), ∀ z : ℂ,
    g z = if z ∈ closedBall c r then c + exp (-(2 * π * I / 5)) * (z - c) else z}

/-- The fivefold threshold in radicals. -/
noncomputable abbrev radius : ℝ := √(3 + (1 + √5) / 2)

/-- The group is finite exactly below the threshold. -/
theorem finite_iff (r : ℝ) : Finite (group r) ↔ r < radius := by
  sorry

end FiveDisk
