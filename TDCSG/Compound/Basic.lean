module

public import Mathlib.GroupTheory.GroupAction.FixingSubgroup
public import Mathlib.GroupTheory.NoncommPiCoprod
public import Mathlib.GroupTheory.Perm.Support
public import Mathlib.Topology.MetricSpace.Isometry
public import TDCSG.BoundedOrbits

/-!
# Compound symmetry groups of a family of balls

Let `X` be a pseudometric space and let `(c i, r i)`, `i : ι`, be a family of closed balls
`closedBall (c i) (r i)` in `X`. For each `i` fix a group `H i` of isometries of the ball
`closedBall (c i) (r i)`, regarded as a metric space in its own right. Every isometry of a ball
extends to a permutation of `X` that acts on the ball and fixes every point outside it. The
*compound symmetry group* of the family is the group of permutations of `X` generated by all these
extensions.

The two-disk compound symmetry groups `TDCSG.GG` are the case `X = ℂ`, `ι = Fin 2`, with two
closed disks centred at `∓1` and `H i` the cyclic group generated by a rotation of the disk.

## Main definitions

* `IsometryEquiv.toPerm`: the isometry group of a space as a group of permutations.
* `TDCSG.ballPerm c r`: the extension of isometries of `closedBall c r` to permutations of `X`,
  as a monoid homomorphism.
* `TDCSG.ballRestrict e he r`: the restriction of an isometry `e` of `X` fixing `c` to
  `closedBall c r`.
* `TDCSG.ballUnion c r`: the union of the balls of the family.
* `TDCSG.compoundSymmetryGroup c r H`: the compound symmetry group, the supremum of the images of
  the groups `H i`.

## Main statements

* `TDCSG.ballPerm_injective`: the extension is injective.
* `TDCSG.compoundSymmetryGroup_mono`: the compound symmetry group is monotone in the `H i`.
* `TDCSG.compoundSymmetryGroup_eq_closure_of_eq_closure`, `TDCSG.compoundSymmetryGroup_zpowers`:
  generators of the `H i` give generators of the compound symmetry group.
* `TDCSG.apply_eq_of_notMem_ballUnion`, `TDCSG.image_ballUnion`,
  `TDCSG.orbit_subset_insert_ballUnion`: the group fixes every point outside the union of the
  balls and maps the union onto itself, so the orbit of a point lies in the union together with
  the point.
* `TDCSG.finite_compoundSymmetryGroup_of_encard_orbit_le`: a finitely generated compound symmetry
  group with uniformly bounded orbits is finite.
* `TDCSG.orbit_subset_orbit_of_eqOn`, `TDCSG.finite_of_forall_orbit_subset`: monotonicity in the
  balls, for orbits and for finiteness.
* `TDCSG.mulEquivPi`, `TDCSG.natCard_compoundSymmetryGroup`: for finitely many pairwise disjoint
  balls the compound symmetry group is the product of the `H i`.

## Implementation notes

The extension is `Equiv.Perm.ofSubtype` composed with `IsometryEquiv.toPerm`. Radii are arbitrary
reals: a ball of negative radius is empty, its isometry group is trivial, and it contributes
nothing to the compound symmetry group (`TDCSG.ballPerm_eq_one_of_neg`).
-/

@[expose] public section

open Equiv Function Metric Set

namespace IsometryEquiv

variable {α : Type*} [PseudoEMetricSpace α]

/-- `IsometryEquiv.toEquiv` as a monoid homomorphism from the isometry group of `α` to the group
of permutations of `α`. -/
@[simps]
def toPerm : (α ≃ᵢ α) →* Perm α where
  toFun e := e.toEquiv
  map_one' := rfl
  map_mul' _ _ := rfl

/-- The isometry group acts faithfully: `IsometryEquiv.toPerm` is injective. -/
theorem toPerm_injective : Function.Injective (toPerm : (α ≃ᵢ α) →* Perm α) :=
  fun _ _ h ↦ ext fun x ↦ Equiv.congr_fun h x

end IsometryEquiv

namespace TDCSG

variable {X ι : Type*} [PseudoMetricSpace X]

open scoped Classical in
/-- The extension of an isometry of the closed ball `closedBall c r` to a permutation of `X`: it
acts on the ball as the isometry and fixes every point outside the ball. -/
noncomputable def ballPerm (c : X) (r : ℝ) :
    (closedBall c r ≃ᵢ closedBall c r) →* Perm X :=
  Perm.ofSubtype.comp IsometryEquiv.toPerm

/-- The restriction to `closedBall c r` of an isometry `e` of `X` that fixes `c`. -/
def ballRestrict (e : X ≃ᵢ X) {c : X} (he : e c = c) (r : ℝ) :
    closedBall c r ≃ᵢ closedBall c r where
  toEquiv := e.toEquiv.subtypeEquiv fun x ↦ by
    change dist x c ≤ r ↔ dist (e x) c ≤ r
    rw [← e.dist_eq x c, he]
  isometry_toFun := fun x y ↦ e.isometry.edist_eq x y

/-- The union of the closed balls `closedBall (c i) (r i)`. -/
def ballUnion (c : ι → X) (r : ι → ℝ) : Set X := ⋃ i, closedBall (c i) (r i)

/-- The compound symmetry group of the family of closed balls `closedBall (c i) (r i)` with
isometry groups `H i`: the group of permutations of `X` generated by the extensions
`TDCSG.ballPerm (c i) (r i) h` of all `h ∈ H i`, for all `i`. -/
noncomputable def compoundSymmetryGroup (c : ι → X) (r : ι → ℝ)
    (H : ∀ i, Subgroup (closedBall (c i) (r i) ≃ᵢ closedBall (c i) (r i))) :
    Subgroup (Perm X) :=
  ⨆ i, (H i).map (ballPerm (c i) (r i))

/-! ### Extension of ball isometries -/

section ballPerm

variable {c : X} {r : ℝ}

/-- On its ball, the extension of a ball isometry acts as the isometry. -/
theorem ballPerm_apply_of_mem (h : closedBall c r ≃ᵢ closedBall c r) {x : X}
    (hx : x ∈ closedBall c r) : ballPerm c r h x = h ⟨x, hx⟩ := by
  classical
  exact Perm.ofSubtype_apply_of_mem (IsometryEquiv.toPerm h) hx

/-- On its ball, the extension of a ball isometry acts as the isometry. -/
@[simp]
theorem ballPerm_apply_coe (h : closedBall c r ≃ᵢ closedBall c r) (x : closedBall c r) :
    ballPerm c r h x = h x :=
  ballPerm_apply_of_mem h x.2

/-- Off its ball, the extension of a ball isometry is the identity. -/
theorem ballPerm_apply_of_notMem (h : closedBall c r ≃ᵢ closedBall c r) {x : X}
    (hx : x ∉ closedBall c r) : ballPerm c r h x = x := by
  classical
  exact Perm.ofSubtype_apply_of_not_mem (IsometryEquiv.toPerm h) hx

/-- The extension of ball isometries to permutations of `X` is injective. -/
theorem ballPerm_injective (c : X) (r : ℝ) : Function.Injective (ballPerm c r) := by
  classical
  exact Perm.ofSubtype_injective.comp IsometryEquiv.toPerm_injective

/-- The extension of a ball isometry maps the ball onto itself. -/
theorem ballPerm_apply_mem_iff (h : closedBall c r ≃ᵢ closedBall c r) (x : X) :
    ballPerm c r h x ∈ closedBall c r ↔ x ∈ closedBall c r := by
  by_cases hx : x ∈ closedBall c r
  · simp only [hx, ballPerm_apply_of_mem h hx, Subtype.coe_prop]
  · rw [ballPerm_apply_of_notMem h hx]

/-- A ball of negative radius is empty, so the extension of its only isometry is the identity. -/
theorem ballPerm_eq_one_of_neg (hr : r < 0) (h : closedBall c r ≃ᵢ closedBall c r) :
    ballPerm c r h = 1 :=
  Perm.ext fun x ↦ ballPerm_apply_of_notMem h (by simp [closedBall_eq_empty.2 hr])

/-- The restriction of `e` to a ball acts as `e`. -/
@[simp]
theorem coe_ballRestrict_apply (e : X ≃ᵢ X) (he : e c = c) (r : ℝ) (x : closedBall c r) :
    (ballRestrict e he r x : X) = e x :=
  rfl

/-- On the ball, the extension of the restriction of an isometry `e` acts as `e`. -/
theorem ballPerm_ballRestrict_apply_of_mem (e : X ≃ᵢ X) (he : e c = c) {x : X}
    (hx : x ∈ closedBall c r) : ballPerm c r (ballRestrict e he r) x = e x := by
  rw [ballPerm_apply_of_mem _ hx, coe_ballRestrict_apply]

/-- The extensions of isometries of two disjoint balls commute. -/
theorem commute_ballPerm {c₁ c₂ : X} {r₁ r₂ : ℝ}
    (hd : Disjoint (closedBall c₁ r₁) (closedBall c₂ r₂))
    (h₁ : closedBall c₁ r₁ ≃ᵢ closedBall c₁ r₁) (h₂ : closedBall c₂ r₂ ≃ᵢ closedBall c₂ r₂) :
    Commute (ballPerm c₁ r₁ h₁) (ballPerm c₂ r₂ h₂) := by
  refine Perm.Disjoint.commute fun x ↦ ?_
  by_cases hx : x ∈ closedBall c₁ r₁
  · exact .inr (ballPerm_apply_of_notMem h₂ (Set.disjoint_left.1 hd hx))
  · exact .inl (ballPerm_apply_of_notMem h₁ hx)

end ballPerm

/-! ### The compound symmetry group -/

section compoundSymmetryGroup

variable {c : ι → X} {r : ι → ℝ}
  {H : ∀ i, Subgroup (closedBall (c i) (r i) ≃ᵢ closedBall (c i) (r i))}

/-- The extensions of the elements of each `H i` lie in the compound symmetry group. -/
theorem ballPerm_mem_compoundSymmetryGroup {i : ι}
    {h : closedBall (c i) (r i) ≃ᵢ closedBall (c i) (r i)} (hh : h ∈ H i) :
    ballPerm (c i) (r i) h ∈ compoundSymmetryGroup c r H :=
  Subgroup.mem_iSup_of_mem i (Subgroup.mem_map_of_mem _ hh)

/-- The compound symmetry group is the least group of permutations containing the extensions
of the elements of all `H i`. -/
theorem compoundSymmetryGroup_le_iff {K : Subgroup (Perm X)} :
    compoundSymmetryGroup c r H ≤ K ↔ ∀ i, ∀ h ∈ H i, ballPerm (c i) (r i) h ∈ K := by
  simp only [compoundSymmetryGroup, iSup_le_iff, Subgroup.map_le_iff_le_comap]
  exact forall_congr' fun i ↦ ⟨fun h x hx ↦ h hx, fun h x hx ↦ h x hx⟩

/-- The compound symmetry group is monotone in the isometry groups of the balls. -/
theorem compoundSymmetryGroup_mono
    {H' : ∀ i, Subgroup (closedBall (c i) (r i) ≃ᵢ closedBall (c i) (r i))}
    (hH : ∀ i, H i ≤ H' i) : compoundSymmetryGroup c r H ≤ compoundSymmetryGroup c r H' :=
  iSup_mono fun i ↦ Subgroup.map_mono (hH i)

/-- If each `H i` is generated by `S i`, the compound symmetry group is generated by the
extensions of the elements of all `S i`. -/
theorem compoundSymmetryGroup_eq_closure_of_eq_closure
    {S : ∀ i, Set (closedBall (c i) (r i) ≃ᵢ closedBall (c i) (r i))}
    (hS : ∀ i, H i = Subgroup.closure (S i)) :
    compoundSymmetryGroup c r H = Subgroup.closure (⋃ i, ballPerm (c i) (r i) '' S i) := by
  simp only [compoundSymmetryGroup, hS, MonoidHom.map_closure, Subgroup.closure_iUnion]

/-- The compound symmetry group is generated by the extensions of the elements of all `H i`. -/
theorem compoundSymmetryGroup_eq_closure :
    compoundSymmetryGroup c r H = Subgroup.closure (⋃ i, ballPerm (c i) (r i) '' H i) :=
  compoundSymmetryGroup_eq_closure_of_eq_closure fun _ ↦ (Subgroup.closure_eq _).symm

/-- If each `H i` is cyclic, generated by `h i`, the compound symmetry group is generated by the
extensions of the `h i`. -/
theorem compoundSymmetryGroup_zpowers (h : ∀ i, closedBall (c i) (r i) ≃ᵢ closedBall (c i) (r i)) :
    compoundSymmetryGroup c r (fun i ↦ Subgroup.zpowers (h i)) =
      Subgroup.closure (range fun i ↦ ballPerm (c i) (r i) (h i)) := by
  rw [compoundSymmetryGroup_eq_closure_of_eq_closure (S := fun i ↦ {h i})
    fun i ↦ Subgroup.zpowers_eq_closure _]
  simp only [image_singleton, iUnion_singleton_eq_range]

/-- The compound symmetry group fixes every point outside the union of the balls. -/
theorem compoundSymmetryGroup_le_fixingSubgroup :
    compoundSymmetryGroup c r H ≤ fixingSubgroup (Perm X) (ballUnion c r)ᶜ := by
  refine compoundSymmetryGroup_le_iff.2 fun i h _ ↦ (mem_fixingSubgroup_iff _).2 fun x hx ↦ ?_
  exact ballPerm_apply_of_notMem h fun hxi ↦ hx (mem_iUnion_of_mem i hxi)

/-- Every element of the compound symmetry group fixes each point outside the union of the
balls. -/
theorem apply_eq_of_notMem_ballUnion {g : Perm X} (hg : g ∈ compoundSymmetryGroup c r H)
    {x : X} (hx : x ∉ ballUnion c r) : g x = x :=
  (mem_fixingSubgroup_iff _).1 (compoundSymmetryGroup_le_fixingSubgroup hg) x hx

/-- Every element of the compound symmetry group maps the union of the balls onto itself. -/
theorem apply_mem_ballUnion_iff {g : Perm X} (hg : g ∈ compoundSymmetryGroup c r H) (x : X) :
    g x ∈ ballUnion c r ↔ x ∈ ballUnion c r := by
  refine ⟨fun h ↦ ?_, fun hx ↦ ?_⟩
  · by_contra hx
    rw [apply_eq_of_notMem_ballUnion hg hx] at h
    exact hx h
  · by_contra h
    rw [g.injective (apply_eq_of_notMem_ballUnion hg h)] at h
    exact h hx

/-- Every element of the compound symmetry group maps the union of the balls onto itself. -/
theorem image_ballUnion {g : Perm X} (hg : g ∈ compoundSymmetryGroup c r H) :
    g '' ballUnion c r = ballUnion c r := by
  ext y
  refine ⟨?_, fun hy ↦ ⟨g⁻¹ y, (apply_mem_ballUnion_iff hg _).1 (by simpa using hy), by simp⟩⟩
  rintro ⟨x, hx, rfl⟩
  exact (apply_mem_ballUnion_iff hg x).2 hx

/-- The orbit of a point lies in the union of the balls together with the point itself. -/
theorem orbit_subset_insert_ballUnion (x : X) :
    MulAction.orbit (compoundSymmetryGroup c r H) x ⊆ insert x (ballUnion c r) := by
  rintro _ ⟨g, rfl⟩
  change (g : Perm X) x ∈ insert x (ballUnion c r)
  by_cases hx : x ∈ ballUnion c r
  · exact .inr ((apply_mem_ballUnion_iff g.2 x).2 hx)
  · exact .inl (apply_eq_of_notMem_ballUnion g.2 hx)

/-- A point outside the union of the balls has a trivial orbit. -/
theorem orbit_eq_singleton_of_notMem_ballUnion {x : X} (hx : x ∉ ballUnion c r) :
    MulAction.orbit (compoundSymmetryGroup c r H) x = {x} := by
  refine Set.eq_singleton_iff_unique_mem.2 ⟨MulAction.mem_orbit_self x, ?_⟩
  rintro _ ⟨g, rfl⟩
  exact apply_eq_of_notMem_ballUnion g.2 hx

/-! ### Finiteness -/

/-- Finitely many balls whose isometry groups are finitely generated give a finitely generated
compound symmetry group. -/
instance [Finite ι] [∀ i, Group.FG (H i)] : Group.FG (compoundSymmetryGroup c r H) := by
  choose S hS hfin using fun i ↦
    (Subgroup.fg_iff _).1 ((Group.fg_iff_subgroup_fg (H i)).1 inferInstance)
  rw [Group.fg_iff_subgroup_fg, compoundSymmetryGroup_eq_closure_of_eq_closure fun i ↦ (hS i).symm,
    Subgroup.fg_iff]
  exact ⟨_, rfl, finite_iUnion fun i ↦ (hfin i).image _⟩

/-- A finitely generated compound symmetry group whose orbits are uniformly bounded is finite. -/
theorem finite_compoundSymmetryGroup_of_encard_orbit_le [Group.FG (compoundSymmetryGroup c r H)]
    (N : ℕ) (h : ∀ x : X, (MulAction.orbit (compoundSymmetryGroup c r H) x).encard ≤ N) :
    Finite (compoundSymmetryGroup c r H) :=
  MulAction.finite_of_encard_orbit_le N h

omit [PseudoMetricSpace X] in
/-- A subgroup of the permutations of `X` has orbits of size at most its order. -/
theorem encard_orbit_le_natCard (G : Subgroup (Perm X)) [Finite G] (x : X) :
    (MulAction.orbit G x).encard ≤ Nat.card G := by
  rw [MulAction.orbit, ← image_univ, ← ENat.card_eq_coe_natCard, ← encard_univ]
  exact encard_image_le _ _

omit [PseudoMetricSpace X] in
/-- A finitely generated group of permutations whose orbits lie in the orbits of a finite group
of permutations is finite. -/
theorem finite_of_forall_orbit_subset {G G' : Subgroup (Perm X)} [Group.FG G] [Finite G']
    (h : ∀ x : X, MulAction.orbit G x ⊆ MulAction.orbit G' x) : Finite G :=
  MulAction.finite_of_encard_orbit_le (Nat.card G') fun x ↦
    (encard_le_encard (h x)).trans (encard_orbit_le_natCard G' x)

/-! ### Monotonicity in the balls -/

/-- Monotonicity in the balls: if each `H i` is generated by `S i`, and the extension of every
element of every `S i` agrees on its ball with an element of a group `G'` of permutations of `X`,
then every orbit of the compound symmetry group lies in the orbit of `G'` of the same point. -/
theorem orbit_subset_orbit_of_eqOn
    {S : ∀ i, Set (closedBall (c i) (r i) ≃ᵢ closedBall (c i) (r i))}
    (hS : ∀ i, H i = Subgroup.closure (S i)) {G' : Subgroup (Perm X)}
    (h : ∀ i, ∀ s ∈ S i, ∃ g ∈ G', EqOn (ballPerm (c i) (r i) s) g (closedBall (c i) (r i)))
    (x : X) : MulAction.orbit (compoundSymmetryGroup c r H) x ⊆ MulAction.orbit G' x := by
  set O := MulAction.orbit G' x
  have hO : ∀ g ∈ G', ∀ y ∈ O, g y ∈ O := fun g hg y hy ↦ by
    have := MulAction.mem_orbit y (⟨g, hg⟩ : G')
    rwa [MulAction.orbit_eq_iff.2 hy] at this
  have key : ∀ g ∈ compoundSymmetryGroup c r H, ∀ y ∈ O, g y ∈ O ∧ g⁻¹ y ∈ O := by
    intro g hg
    rw [compoundSymmetryGroup_eq_closure_of_eq_closure hS] at hg
    induction hg using Subgroup.closure_induction with
    | mem f hf =>
      obtain ⟨i, s, hs, rfl⟩ : ∃ i, ∃ s ∈ S i, ballPerm (c i) (r i) s = f := by
        simpa only [mem_iUnion, mem_image] using hf
      obtain ⟨g, hg, hsg⟩ := h i s hs
      intro y hy
      refine ⟨?_, ?_⟩
      · by_cases hyb : y ∈ closedBall (c i) (r i)
        · rw [hsg hyb]
          exact hO g hg y hy
        · rwa [ballPerm_apply_of_notMem s hyb]
      · set z := (ballPerm (c i) (r i) s)⁻¹ y
        have hzy : ballPerm (c i) (r i) s z = y := by simp [z]
        by_cases hzb : z ∈ closedBall (c i) (r i)
        · have hz : z = g⁻¹ y := by rw [← hzy, hsg hzb]; simp
          rw [hz]
          exact hO _ (inv_mem hg) y hy
        · rwa [← hzy, ballPerm_apply_of_notMem s hzb] at hy
    | one => exact fun y hy ↦ ⟨hy, hy⟩
    | mul g k _ _ ihg ihk =>
      intro y hy
      refine ⟨(ihg _ (ihk y hy).1).1, ?_⟩
      rw [mul_inv_rev, Perm.mul_apply]
      exact (ihk _ (ihg y hy).2).2
    | inv g _ ihg =>
      intro y hy
      simpa only [inv_inv, and_comm] using ihg y hy
  rintro _ ⟨g, rfl⟩
  exact (key g g.2 x (MulAction.mem_orbit_self x)).1

/-! ### Disjoint balls -/

/-- For pairwise disjoint balls the images of the groups `H i` are independent. -/
theorem iSupIndep_map_ballPerm (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) :
    iSupIndep fun i ↦ (H i).map (ballPerm (c i) (r i)) := by
  refine iSupIndep_def.2 fun i ↦ Subgroup.disjoint_def.2 fun {g} hg hg' ↦ ?_
  have h₁ : (H i).map (ballPerm (c i) (r i)) ≤
      fixingSubgroup (Perm X) (closedBall (c i) (r i))ᶜ := by
    rintro _ ⟨h, -, rfl⟩
    exact (mem_fixingSubgroup_iff _).2 fun x hx ↦ ballPerm_apply_of_notMem h hx
  have h₂ : (⨆ (j) (_ : j ≠ i), (H j).map (ballPerm (c j) (r j))) ≤
      fixingSubgroup (Perm X) (closedBall (c i) (r i)) := by
    refine iSup₂_le fun j hj ↦ ?_
    rintro _ ⟨h, -, rfl⟩
    exact (mem_fixingSubgroup_iff _).2 fun x hx ↦
      ballPerm_apply_of_notMem h (Set.disjoint_left.1 (hd hj.symm) hx)
  refine Perm.ext fun x ↦ ?_
  by_cases hx : x ∈ closedBall (c i) (r i)
  · exact (mem_fixingSubgroup_iff _).1 (h₂ hg') x hx
  · exact (mem_fixingSubgroup_iff _).1 (h₁ hg) x hx

/-- For pairwise disjoint balls, extensions of isometries of different balls commute. -/
theorem pairwise_commute_ballPerm (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) :
    Pairwise fun i j ↦ ∀ (x : H i) (y : H j),
      Commute ((ballPerm (c i) (r i)).comp (H i).subtype x)
        ((ballPerm (c j) (r j)).comp (H j).subtype y) :=
  fun _ _ hij _ _ ↦ commute_ballPerm (hd hij) _ _

/-- For finitely many pairwise disjoint balls, the homomorphism from the product of the groups
`H i` to the compound symmetry group, multiplying the extensions of the components. -/
noncomputable def piToCompoundSymmetryGroup [Fintype ι]
    (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) :
    (∀ i, H i) →* Perm X :=
  MonoidHom.noncommPiCoprod _ (pairwise_commute_ballPerm hd)

/-- On the `i`-th factor, `TDCSG.piToCompoundSymmetryGroup` is the extension from the `i`-th
ball. -/
theorem piToCompoundSymmetryGroup_mulSingle [Fintype ι] [DecidableEq ι]
    (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) (i : ι) (h : H i) :
    piToCompoundSymmetryGroup hd (Pi.mulSingle i h) = ballPerm (c i) (r i) h :=
  MonoidHom.noncommPiCoprod_mulSingle _ _ _

/-- For pairwise disjoint balls, `TDCSG.piToCompoundSymmetryGroup` is injective. -/
theorem injective_piToCompoundSymmetryGroup [Fintype ι]
    (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) :
    Function.Injective (piToCompoundSymmetryGroup (H := H) hd) := by
  refine MonoidHom.injective_noncommPiCoprod_of_iSupIndep _ ?_
    fun _ ↦ (ballPerm_injective _ _).comp Subtype.val_injective
  simpa only [MonoidHom.range_comp, Subgroup.range_subtype] using iSupIndep_map_ballPerm hd

/-- The range of `TDCSG.piToCompoundSymmetryGroup` is the compound symmetry group. -/
theorem range_piToCompoundSymmetryGroup [Fintype ι]
    (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) :
    (piToCompoundSymmetryGroup (H := H) hd).range = compoundSymmetryGroup c r H := by
  rw [piToCompoundSymmetryGroup, MonoidHom.noncommPiCoprod_range]
  simp only [MonoidHom.range_comp, Subgroup.range_subtype, compoundSymmetryGroup]

/-- For finitely many pairwise disjoint balls, the compound symmetry group is the product of the
isometry groups of the balls. -/
noncomputable def mulEquivPi [Fintype ι]
    (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) :
    compoundSymmetryGroup c r H ≃* ∀ i, H i :=
  ((MonoidHom.ofInjective (injective_piToCompoundSymmetryGroup hd)).trans
    (MulEquiv.subgroupCongr (range_piToCompoundSymmetryGroup hd))).symm

/-- The inverse of `TDCSG.mulEquivPi` is `TDCSG.piToCompoundSymmetryGroup`. -/
@[simp]
theorem coe_mulEquivPi_symm_apply [Fintype ι]
    (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) (h : ∀ i, H i) :
    ((mulEquivPi hd).symm h : Perm X) = piToCompoundSymmetryGroup hd h :=
  rfl

/-- For finitely many pairwise disjoint balls, the compound symmetry group is isomorphic to the
product of the isometry groups of the balls. -/
theorem nonempty_mulEquiv_pi [Finite ι]
    (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) :
    Nonempty (compoundSymmetryGroup c r H ≃* ∀ i, H i) :=
  let := Fintype.ofFinite ι
  ⟨mulEquivPi hd⟩

/-- For finitely many pairwise disjoint balls, the order of the compound symmetry group is the
product of the orders of the isometry groups of the balls. -/
theorem natCard_compoundSymmetryGroup [Fintype ι]
    (hd : Pairwise (Disjoint on fun i ↦ closedBall (c i) (r i))) :
    Nat.card (compoundSymmetryGroup c r H) = ∏ i, Nat.card (H i) := by
  rw [Nat.card_congr (mulEquivPi hd).toEquiv, Nat.card_pi]

end compoundSymmetryGroup

end TDCSG

