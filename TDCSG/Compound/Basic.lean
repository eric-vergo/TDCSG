module

public import Mathlib.GroupTheory.GroupAction.FixingSubgroup
public import Mathlib.GroupTheory.NoncommPiCoprod
public import Mathlib.Topology.MetricSpace.Isometry
public import TDCSG.BoundedOrbits

/-!
# Compound symmetry groups of a family of balls

Let `X` be a pseudometric space and let `(c i, r i)`, `i : ι`, be a family of closed balls
`closedBall (c i) (r i)` in `X`. For each `i` fix a group `H i` of isometries of the ball
`closedBall (c i) (r i)`, regarded as a metric space in its own right. Every isometry of a ball
extends to a permutation of `X` that acts on the ball and fixes every point outside it. The
*compound symmetry group* of the family is the group of permutations of `X` generated by all these
extensions.

The two-disk compound symmetry groups `TDCSG.GG` are the case `X = ℂ`, `ι = Fin 2`, with two
closed disks centred at `∓1` and `H i` the cyclic group generated by a rotation of the disk.

## Main definitions

* `IsometryEquiv.toPerm`: the isometry group of a space as a group of permutations.
* `TDCSG.ballPerm c r`: the extension of isometries of `closedBall c r` to permutations of `X`,
  as a monoid homomorphism.
* `TDCSG.ballRestrict e he r`: the restriction of an isometry `e` of `X` fixing `c` to
  `closedBall c r`.
* `TDCSG.ballUnion c r`: the union of the balls of the family.
* `TDCSG.compoundSymmetryGroup c r H`: the compound symmetry group, the supremum of the images of
  the groups `H i`.

## Implementation notes

The extension is `Equiv.Perm.ofSubtype` composed with `IsometryEquiv.toPerm`. Radii are arbitrary
reals: a ball of negative radius is empty, its isometry group is trivial, and it contributes
nothing to the compound symmetry group (`TDCSG.ballPerm_eq_one_of_neg`).
-/

@[expose] public section

open Equiv Metric Set

namespace IsometryEquiv

variable {α : Type*} [PseudoEMetricSpace α]

/-- `IsometryEquiv.toEquiv` as a monoid homomorphism from the isometry group of `α` to the group
of permutations of `α`. -/
@[simps]
def toPerm : (α ≃ᵢ α) →* Perm α where
  toFun e := e.toEquiv
  map_one' := rfl
  map_mul' _ _ := rfl

end IsometryEquiv

namespace TDCSG

variable {X ι : Type*} [PseudoMetricSpace X]

open scoped Classical in
/-- The extension of an isometry of the closed ball `closedBall c r` to a permutation of `X`: it
acts on the ball as the isometry and fixes every point outside the ball. -/
noncomputable def ballPerm (c : X) (r : ℝ) :
    (closedBall c r ≃ᵢ closedBall c r) →* Perm X :=
  Perm.ofSubtype.comp IsometryEquiv.toPerm

/-- The restriction to `closedBall c r` of an isometry `e` of `X` that fixes `c`. -/
def ballRestrict (e : X ≃ᵢ X) {c : X} (he : e c = c) (r : ℝ) :
    closedBall c r ≃ᵢ closedBall c r where
  toEquiv := e.toEquiv.subtypeEquiv fun x ↦ by
    change dist x c ≤ r ↔ dist (e x) c ≤ r
    rw [← e.dist_eq x c, he]
  isometry_toFun := fun x y ↦ e.isometry.edist_eq x y

/-- The union of the closed balls `closedBall (c i) (r i)`. -/
def ballUnion (c : ι → X) (r : ι → ℝ) : Set X := ⋃ i, closedBall (c i) (r i)

/-- The compound symmetry group of the family of closed balls `closedBall (c i) (r i)` with
isometry groups `H i`: the group of permutations of `X` generated by the extensions
`TDCSG.ballPerm (c i) (r i) h` of all `h ∈ H i`, for all `i`. -/
noncomputable def compoundSymmetryGroup (c : ι → X) (r : ι → ℝ)
    (H : ∀ i, Subgroup (closedBall (c i) (r i) ≃ᵢ closedBall (c i) (r i))) :
    Subgroup (Perm X) :=
  ⨆ i, (H i).map (ballPerm (c i) (r i))

end TDCSG

end
