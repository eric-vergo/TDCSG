module

public import TDCSG.Basic
public import TDCSG.Compound.Basic

/-!
# The two-disk compound symmetry group

This file packages the two generators of `TDCSG.Basic` as permutations of `ℂ` and defines the
two-disk compound symmetry group `TDCSG.GG n₁ n₂ r₁ r₂`, with rotation orders `n₁`, `n₂` and
radii `r₁`, `r₂` for the left and right disk, together with its orbits. The group is the compound
symmetry group (`TDCSG.compoundSymmetryGroup`) of the two closed disks, each carrying the cyclic
group generated by its rotation; `TDCSG.GG_eq_closure` identifies it with the group generated by
the two generators.

## Main definitions

* `TDCSG.diskPerm n c r`: the disk rotation `TDCSG.diskRotation n c r` as a permutation of `ℂ`.
* `TDCSG.permA n r`, `TDCSG.permB n r`: the generators `TDCSG.genA n r`, `TDCSG.genB n r` as
  permutations of `ℂ`.
* `TDCSG.rotationIsometry n c`: the rotation `TDCSG.rotation n c` as an isometry of `ℂ`.
* `TDCSG.ballRotation n c r`: its restriction to the closed disk of radius `r` about `c`, an
  isometry of the disk.
* `TDCSG.GG n₁ n₂ r₁ r₂`: the compound symmetry group of the closed disks of radii `r₁`, `r₂`
  about `-1`, `1`, with the cyclic groups generated by `ballRotation n₁ (-1) r₁` and
  `ballRotation n₂ 1 r₂`.
* `TDCSG.orbit n₁ n₂ r₁ r₂ p`: the orbit of `p` under `TDCSG.GG n₁ n₂ r₁ r₂`.
* `TDCSG.diskUnion r₁ r₂`: the union of the two closed disks.
* `TDCSG.preserving S`: the subgroup of permutations mapping the set `S` onto itself.
* `TDCSG.TouchesBoundary S r`, `TDCSG.AccumulatesInside S r`: the two alternatives of the
  boundary-contact dichotomy for a set `S` and the common radius `r`.

## Main statements

* `TDCSG.ballPerm_ballRotation`: the extension of `TDCSG.ballRotation n c r` to `ℂ` is
  `TDCSG.diskPerm n c r`.
* `TDCSG.GG_eq_closure`: `GG n₁ n₂ r₁ r₂` is generated by `permA n₁ r₁` and `permB n₂ r₂`.
* `TDCSG.orbit_subset`, `TDCSG.mem_preserving_of_mapsTo`: an orbit lies in every set that
  contains its base point and is mapped into itself by both generators.

## Implementation notes

For `n = 0` the angle `-2π / n` is `0` in Lean, so `diskRotation 0 c r` is the identity; this
makes `TDCSG.diskPerm` total in `n`. All theorems about genuine rotations carry hypotheses that
exclude this case where it matters.
-/

@[expose] public section

open Complex Metric Equiv Filter Topology
open scoped Real

namespace TDCSG

/-- For `n = 0` the rotation angle is `0`, so the rotation is the identity. -/
@[simp]
theorem rotation_zero (c z : ℂ) : rotation 0 c z = z := by
  simp [rotation]

/-- For `n = 0` the disk rotation is the identity. -/
theorem diskRotation_zero (c : ℂ) (r : ℝ) : diskRotation 0 c r = id := by
  ext1 z
  by_cases hz : z ∈ closedBall c r <;> simp [diskRotation, hz]

/-- The disk rotation `TDCSG.diskRotation n c r` as a permutation of `ℂ`. -/
noncomputable def diskPerm (n : ℕ) (c : ℂ) (r : ℝ) : Perm ℂ :=
  Equiv.ofBijective (diskRotation n c r) <| by
    rcases eq_or_ne n 0 with rfl | hn
    · rw [diskRotation_zero]
      exact Function.bijective_id
    · exact bijective_diskRotation hn c r

@[simp]
theorem diskPerm_apply (n : ℕ) (c : ℂ) (r : ℝ) (z : ℂ) :
    diskPerm n c r z = diskRotation n c r z :=
  rfl

/-- The left generator `TDCSG.genA n r` as a permutation of `ℂ`. -/
noncomputable def permA (n : ℕ) (r : ℝ) : Perm ℂ := diskPerm n leftCenter r

/-- The right generator `TDCSG.genB n r` as a permutation of `ℂ`. -/
noncomputable def permB (n : ℕ) (r : ℝ) : Perm ℂ := diskPerm n rightCenter r

@[simp]
theorem permA_apply (n : ℕ) (r : ℝ) (z : ℂ) : permA n r z = genA n r z :=
  rfl

@[simp]
theorem permB_apply (n : ℕ) (r : ℝ) (z : ℂ) : permB n r z = genB n r z :=
  rfl

/-- A rotation fixes its centre. -/
@[simp]
theorem rotation_self (n : ℕ) (c : ℂ) : rotation n c c = c := by
  simp [rotation]

/-- The rotation `TDCSG.rotation n c` by `-2π / n` about `c`, as an isometry of `ℂ`. -/
noncomputable def rotationIsometry (n : ℕ) (c : ℂ) : ℂ ≃ᵢ ℂ where
  toFun := rotation n c
  invFun z := c + exp (2 * π * I / n) * (z - c)
  left_inv z := by
    simp only [rotation, add_sub_cancel_left, ← mul_assoc, ← exp_add, add_neg_cancel, exp_zero,
      one_mul, add_sub_cancel]
  right_inv z := by
    simp only [rotation, add_sub_cancel_left, ← mul_assoc, ← exp_add, neg_add_cancel, exp_zero,
      one_mul, add_sub_cancel]
  isometry_toFun := Isometry.of_dist_eq fun z w ↦ by
    simp only [rotation, dist_eq_norm, add_sub_add_left_eq_sub, ← mul_sub, norm_mul,
      norm_exp_rotationAngle, one_mul, sub_sub_sub_cancel_right]

@[simp]
theorem rotationIsometry_apply (n : ℕ) (c z : ℂ) : rotationIsometry n c z = rotation n c z :=
  rfl

/-- The rotation `TDCSG.rotationIsometry n c` fixes its centre. -/
theorem rotationIsometry_self (n : ℕ) (c : ℂ) : rotationIsometry n c c = c :=
  rotation_self n c

/-- The rotation by `-2π / n` of the closed disk of radius `r` about `c`, as an isometry of the
disk. -/
noncomputable def ballRotation (n : ℕ) (c : ℂ) (r : ℝ) : closedBall c r ≃ᵢ closedBall c r :=
  ballRestrict (rotationIsometry n c) (rotationIsometry_self n c) r

/-- Extending the rotation of a disk to the plane gives the disk rotation. -/
theorem ballPerm_ballRotation (n : ℕ) (c : ℂ) (r : ℝ) :
    ballPerm c r (ballRotation n c r) = diskPerm n c r := by
  refine Perm.ext fun z ↦ ?_
  by_cases hz : z ∈ closedBall c r
  · rw [ballRotation, ballPerm_ballRestrict_apply_of_mem _ _ hz, diskPerm_apply,
      diskRotation_of_mem hz, rotationIsometry_apply]
  · rw [ballPerm_apply_of_notMem _ hz, diskPerm_apply, diskRotation_of_notMem hz]

/-- The two-disk compound symmetry group `GG_{n₁,n₂}(r₁, r₂)`: the compound symmetry group of the
closed disk of radius `r₁` about `-1`, with the cyclic group generated by its rotation by
`-2π / n₁`, and the closed disk of radius `r₂` about `1`, with the cyclic group generated by its
rotation by `-2π / n₂`. By `TDCSG.GG_eq_closure` it is the group of bijections of the plane
generated by the two disk rotations. -/
noncomputable def GG (n₁ n₂ : ℕ) (r₁ r₂ : ℝ) : Subgroup (Perm ℂ) :=
  compoundSymmetryGroup ![leftCenter, rightCenter] ![r₁, r₂]
    fun i ↦ Subgroup.zpowers (ballRotation (![n₁, n₂] i) _ _)

/-- The two-disk compound symmetry group is generated by the two generators. -/
theorem GG_eq_closure (n₁ n₂ : ℕ) (r₁ r₂ : ℝ) :
    GG n₁ n₂ r₁ r₂ = Subgroup.closure {permA n₁ r₁, permB n₂ r₂} := by
  rw [GG, compoundSymmetryGroup_zpowers]
  congr 1
  ext σ
  simp only [ballPerm_ballRotation, Set.mem_range, Fin.exists_fin_two, Matrix.cons_val_zero,
    Matrix.cons_val_one, Set.mem_insert_iff, Set.mem_singleton_iff, permA,
    permB, eq_comm]

/-- The orbit of the point `p` under `TDCSG.GG n₁ n₂ r₁ r₂`. -/
def orbit (n₁ n₂ : ℕ) (r₁ r₂ : ℝ) (p : ℂ) : Set ℂ :=
  {y | ∃ g ∈ GG n₁ n₂ r₁ r₂, g p = y}

/-- The union of the closed left disk of radius `r₁` and the closed right disk of radius `r₂`. -/
def diskUnion (r₁ r₂ : ℝ) : Set ℂ := leftDisk r₁ ∪ rightDisk r₂

/-- Some point of `S` lies on one of the two boundary circles of radius `r`. -/
def TouchesBoundary (S : Set ℂ) (r : ℝ) : Prop :=
  ∃ y ∈ S, dist y leftCenter = r ∨ dist y rightCenter = r

/-- Points of `S` accumulate at a boundary circle of radius `r` from inside: for every `ε > 0`
infinitely many points of `S` lie strictly inside one of the disks of radius `r`, within `ε` of
its boundary, and some point of one of the boundary circles is an accumulation point of the
points of `S` in the corresponding open disk. -/
def AccumulatesInside (S : Set ℂ) (r : ℝ) : Prop :=
  (∀ ε > 0, {y ∈ S | ∃ c ∈ ({leftCenter, rightCenter} : Set ℂ),
      r - ε < dist y c ∧ dist y c < r}.Infinite) ∧
    ∃ c ∈ ({leftCenter, rightCenter} : Set ℂ), ∃ y, dist y c = r ∧ AccPt y (𝓟 (S ∩ ball c r))

/-- The union of the two disks is the union of the balls of the compound symmetry group
`TDCSG.GG`. -/
theorem ballUnion_eq_diskUnion (r₁ r₂ : ℝ) :
    ballUnion ![leftCenter, rightCenter] ![r₁, r₂] = diskUnion r₁ r₂ := by
  ext z
  simp [ballUnion, diskUnion, leftDisk, rightDisk, Fin.exists_fin_two]

/-- The subgroup of permutations `g` of `ℂ` with `g S ⊆ S` and `g⁻¹ S ⊆ S`, that is, `g S = S`. -/
def preserving (S : Set ℂ) : Subgroup (Perm ℂ) where
  carrier := {g | ∀ y ∈ S, g y ∈ S ∧ g⁻¹ y ∈ S}
  mul_mem' {g h} hg hh := by
    intro y hy
    refine ⟨(hg _ (hh y hy).1).1, ?_⟩
    rw [mul_inv_rev, Perm.mul_apply]
    exact (hh _ (hg y hy).2).2
  one_mem' := fun y hy ↦ ⟨hy, hy⟩
  inv_mem' {g} hg := by
    intro y hy
    simpa [and_comm] using hg y hy

theorem mem_preserving {S : Set ℂ} {g : Perm ℂ} :
    g ∈ preserving S ↔ ∀ y ∈ S, g y ∈ S ∧ g⁻¹ y ∈ S :=
  Iff.rfl

theorem permA_mem_GG (n₁ n₂ : ℕ) (r₁ r₂ : ℝ) : permA n₁ r₁ ∈ GG n₁ n₂ r₁ r₂ := by
  rw [GG_eq_closure]
  exact Subgroup.subset_closure (by simp)

theorem permB_mem_GG (n₁ n₂ : ℕ) (r₁ r₂ : ℝ) : permB n₂ r₂ ∈ GG n₁ n₂ r₁ r₂ := by
  rw [GG_eq_closure]
  exact Subgroup.subset_closure (by simp)

theorem mem_orbit_self (n₁ n₂ : ℕ) (r₁ r₂ : ℝ) (p : ℂ) : p ∈ orbit n₁ n₂ r₁ r₂ p :=
  ⟨1, Subgroup.one_mem _, rfl⟩

theorem GG_le_preserving {n₁ n₂ : ℕ} {r₁ r₂ : ℝ} {S : Set ℂ} (hA : permA n₁ r₁ ∈ preserving S)
    (hB : permB n₂ r₂ ∈ preserving S) : GG n₁ n₂ r₁ r₂ ≤ preserving S := by
  rw [GG_eq_closure, Subgroup.closure_le]
  rintro g (rfl | rfl)
  exacts [hA, hB]

/-- An orbit is contained in every set that contains the base point and is preserved by both
generators. -/
theorem orbit_subset {n₁ n₂ : ℕ} {r₁ r₂ : ℝ} {S : Set ℂ} {p : ℂ} (hp : p ∈ S)
    (hA : permA n₁ r₁ ∈ preserving S) (hB : permB n₂ r₂ ∈ preserving S) :
    orbit n₁ n₂ r₁ r₂ p ⊆ S := by
  rintro y ⟨g, hg, rfl⟩
  exact (GG_le_preserving hA hB hg p hp).1

theorem GG_le_preserving_orbit (n₁ n₂ : ℕ) (r₁ r₂ : ℝ) (p : ℂ) :
    GG n₁ n₂ r₁ r₂ ≤ preserving (orbit n₁ n₂ r₁ r₂ p) := by
  intro g hg
  rintro y ⟨h, hh, rfl⟩
  refine ⟨⟨g * h, Subgroup.mul_mem _ hg hh, rfl⟩, ⟨g⁻¹ * h, ?_, rfl⟩⟩
  exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hg) hh

theorem apply_mem_orbit {n₁ n₂ : ℕ} {r₁ r₂ : ℝ} {p y : ℂ} {g : Perm ℂ}
    (hg : g ∈ GG n₁ n₂ r₁ r₂) (hy : y ∈ orbit n₁ n₂ r₁ r₂ p) : g y ∈ orbit n₁ n₂ r₁ r₂ p :=
  (GG_le_preserving_orbit n₁ n₂ r₁ r₂ p hg y hy).1

/-- A permutation of finite order that maps `S` into itself maps `S` onto itself. -/
theorem mem_preserving_of_mapsTo {S : Set ℂ} {f : Perm ℂ} {n : ℕ} (hn : n ≠ 0)
    (hf : (⇑f)^[n] = id) (h : Set.MapsTo f S S) : f ∈ preserving S := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn
  intro y hy
  refine ⟨h hy, ?_⟩
  have hinv : f⁻¹ y = (⇑f)^[m] y := by
    rw [Perm.inv_eq_iff_eq, ← Function.iterate_succ_apply' f, hf, id]
  rw [hinv]
  exact h.iterate m hy

/-- If `σ` agrees on `S` with a permutation `τ` that maps `S` onto itself, then so does `σ`. -/
theorem mem_preserving_of_eqOn {S : Set ℂ} {σ τ : Perm ℂ} (hτ : τ ∈ preserving S)
    (h : Set.EqOn σ τ S) : σ ∈ preserving S := by
  intro y hy
  refine ⟨by rw [h hy]; exact (hτ y hy).1, ?_⟩
  have hw : σ (τ⁻¹ y) = y := by rw [h (hτ y hy).2]; simp
  rw [← hw]
  simpa using (hτ y hy).2

/-- If at every point `σ` either fixes the point or acts as a permutation `τ` that maps `S` onto
itself, then `σ` maps `S` onto itself. -/
theorem mem_preserving_of_forall_eq_or {S : Set ℂ} {σ τ : Perm ℂ} (hτ : τ ∈ preserving S)
    (h : ∀ w, σ w = w ∨ σ w = τ w) : σ ∈ preserving S := by
  intro y hy
  refine ⟨?_, ?_⟩
  · rcases h y with e | e <;> rw [e]
    exacts [hy, (hτ y hy).1]
  · rcases h (σ⁻¹ y) with e | e <;> rw [show σ (σ⁻¹ y) = y by simp] at e
    · rw [← e]
      exact hy
    · rw [(Perm.inv_eq_iff_eq.2 e).symm]
      exact (hτ y hy).2

end TDCSG

end
