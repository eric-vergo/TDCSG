module

public import Mathlib.Analysis.SpecialFunctions.Complex.Circle

/-!
# Two-disk compound symmetry groups: basic definitions

A two-disk compound symmetry group is generated by two piecewise rotations of the plane. Identify
the plane with `ℂ`, and place two closed disks of radius `r` centred at `-1` and `1`. The generator
`TDCSG.genA n r` rotates the left disk by the angle `-2π / n` about its centre and fixes every
point outside it; `TDCSG.genB n r` does the same for the right disk.

## Main definitions

* `TDCSG.rotation n c`: rotation of `ℂ` by the angle `-2π / n` about `c`.
* `TDCSG.diskRotation n c r`: `TDCSG.rotation n c` on the closed disk of radius `r` about `c`,
  the identity outside it.
* `TDCSG.leftDisk r`, `TDCSG.rightDisk r`: the two closed disks.
* `TDCSG.genA n r`, `TDCSG.genB n r`: the two generators.

## Main statements

* `TDCSG.iterate_rotation_self`: `n` iterates of `TDCSG.rotation n c` give the identity.
* `TDCSG.mapsTo_diskRotation`: a disk rotation maps its disk to itself.
* `TDCSG.iterate_diskRotation_self`: `n` iterates of a disk rotation give the identity.
* `TDCSG.bijective_genA`, `TDCSG.bijective_genB`: the generators are bijections of `ℂ`.

## References

* [R. Hearn, W. Kretschmer, T. Rokicki, B. Streeter, E. Vergo,
  *Two-Disk Compound Symmetry Groups*][arXiv:2302.12950]
-/

@[expose] public section

open Complex Metric
open scoped Real

namespace TDCSG

/-- The centre `-1` of the left disk. -/
def leftCenter : ℂ := -1

/-- The centre `1` of the right disk. -/
def rightCenter : ℂ := 1

/-- The closed left disk of radius `r`, centred at `-1`. -/
def leftDisk (r : ℝ) : Set ℂ := closedBall leftCenter r

/-- The closed right disk of radius `r`, centred at `1`. -/
def rightDisk (r : ℝ) : Set ℂ := closedBall rightCenter r

/-- The rotation of `ℂ` by the angle `-2π / n` about the point `c`. -/
noncomputable def rotation (n : ℕ) (c z : ℂ) : ℂ :=
  c + exp (-(2 * π * I / n)) * (z - c)

open scoped Classical in
/-- The rotation by `-2π / n` about `c` applied to the closed disk of radius `r` about `c`;
points outside that disk are fixed. -/
noncomputable def diskRotation (n : ℕ) (c : ℂ) (r : ℝ) (z : ℂ) : ℂ :=
  if z ∈ closedBall c r then rotation n c z else z

/-- The left generator: rotation by `-2π / n` of the left disk of radius `r`. -/
noncomputable def genA (n : ℕ) (r : ℝ) : ℂ → ℂ := diskRotation n leftCenter r

/-- The right generator: rotation by `-2π / n` of the right disk of radius `r`. -/
noncomputable def genB (n : ℕ) (r : ℝ) : ℂ → ℂ := diskRotation n rightCenter r

theorem norm_exp_rotationAngle (n : ℕ) : ‖exp (-(2 * π * I / n))‖ = 1 := by
  rw [show -(2 * π * I / n) = ((-(2 * π / n) : ℝ) : ℂ) * I by push_cast; ring]
  exact norm_exp_ofReal_mul_I _

theorem exp_rotationAngle_pow_self {n : ℕ} (hn : n ≠ 0) : exp (-(2 * π * I / n)) ^ n = 1 := by
  rw [← exp_nat_mul, show (n : ℂ) * -(2 * π * I / n) = -(2 * π * I) by field_simp, exp_neg,
    exp_two_pi_mul_I, inv_one]

@[simp]
theorem dist_rotation (n : ℕ) (c z : ℂ) : dist (rotation n c z) c = dist z c := by
  simp [rotation, dist_eq_norm, norm_exp_rotationAngle]

theorem iterate_rotation (n : ℕ) (c z : ℂ) (k : ℕ) :
    (rotation n c)^[k] z = c + exp (-(2 * π * I / n)) ^ k * (z - c) := by
  induction k with
  | zero => simp
  | succ k ih => rw [Function.iterate_succ_apply', ih, rotation]; ring

theorem iterate_rotation_self {n : ℕ} (hn : n ≠ 0) (c : ℂ) : (rotation n c)^[n] = id := by
  ext1 z
  simp [iterate_rotation, exp_rotationAngle_pow_self hn]

theorem diskRotation_of_mem {n : ℕ} {c z : ℂ} {r : ℝ} (hz : z ∈ closedBall c r) :
    diskRotation n c r z = rotation n c z := by
  simp [diskRotation, hz]

theorem diskRotation_of_notMem {n : ℕ} {c z : ℂ} {r : ℝ} (hz : z ∉ closedBall c r) :
    diskRotation n c r z = z := by
  simp [diskRotation, hz]

/-- A disk rotation maps its disk to itself. -/
theorem mapsTo_diskRotation (n : ℕ) (c : ℂ) (r : ℝ) :
    Set.MapsTo (diskRotation n c r) (closedBall c r) (closedBall c r) := by
  intro z hz
  rw [diskRotation_of_mem hz, mem_closedBall, dist_rotation]
  exact hz

theorem iterate_diskRotation_of_mem {n : ℕ} {c z : ℂ} {r : ℝ} (hz : z ∈ closedBall c r)
    (k : ℕ) : (diskRotation n c r)^[k] z = (rotation n c)^[k] z := by
  induction k with
  | zero => rfl
  | succ k ih =>
    have hk : (rotation n c)^[k] z ∈ closedBall c r := by
      rw [← ih]
      exact (mapsTo_diskRotation n c r).iterate k hz
    rw [Function.iterate_succ_apply', ih, diskRotation_of_mem hk, Function.iterate_succ_apply']

theorem iterate_diskRotation_of_notMem {n : ℕ} {c z : ℂ} {r : ℝ} (hz : z ∉ closedBall c r)
    (k : ℕ) : (diskRotation n c r)^[k] z = z :=
  Function.iterate_fixed (diskRotation_of_notMem hz) k

/-- `n` iterates of a disk rotation by `-2π / n` give the identity. -/
theorem iterate_diskRotation_self {n : ℕ} (hn : n ≠ 0) (c : ℂ) (r : ℝ) :
    (diskRotation n c r)^[n] = id := by
  ext1 z
  by_cases hz : z ∈ closedBall c r
  · rw [iterate_diskRotation_of_mem hz, iterate_rotation_self hn]
  · exact iterate_diskRotation_of_notMem hz n

/-- A disk rotation by `-2π / n`, for `n ≠ 0`, is a bijection of `ℂ`. -/
theorem bijective_diskRotation {n : ℕ} (hn : n ≠ 0) (c : ℂ) (r : ℝ) :
    Function.Bijective (diskRotation n c r) := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  have h := iterate_diskRotation_self hn c r
  refine Function.bijective_iff_has_inverse.2 ⟨(diskRotation (m + 1) c r)^[m], fun z ↦ ?_,
    fun z ↦ ?_⟩
  · simpa [Function.iterate_succ_apply] using congrFun h z
  · simpa [Function.iterate_succ_apply'] using congrFun h z

theorem iterate_genA_self {n : ℕ} (hn : n ≠ 0) (r : ℝ) : (genA n r)^[n] = id :=
  iterate_diskRotation_self hn leftCenter r

theorem iterate_genB_self {n : ℕ} (hn : n ≠ 0) (r : ℝ) : (genB n r)^[n] = id :=
  iterate_diskRotation_self hn rightCenter r

theorem mapsTo_genA (n : ℕ) (r : ℝ) : Set.MapsTo (genA n r) (leftDisk r) (leftDisk r) :=
  mapsTo_diskRotation n leftCenter r

theorem mapsTo_genB (n : ℕ) (r : ℝ) : Set.MapsTo (genB n r) (rightDisk r) (rightDisk r) :=
  mapsTo_diskRotation n rightCenter r

theorem bijective_genA {n : ℕ} (hn : n ≠ 0) (r : ℝ) : Function.Bijective (genA n r) :=
  bijective_diskRotation hn leftCenter r

theorem bijective_genB {n : ℕ} (hn : n ≠ 0) (r : ℝ) : Function.Bijective (genB n r) :=
  bijective_diskRotation hn rightCenter r

end TDCSG

end
